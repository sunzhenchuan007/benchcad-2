import cadquery as cq

# ── 1. PARAM_SPEC ────────────────────────────────────────────────────────────
# Every parameter: meaning, unit, per-difficulty range, and WHERE THE RANGE
# COMES FROM (standard table / engineering rule / proportion convention).
PARAM_SPEC = {
    "length": dict(
        desc="TODO: what this parameter physically is",
        unit="mm",
        range={"easy": (40.0, 80.0), "medium": (40.0, 120.0), "hard": (30.0, 160.0)},
        source="TODO: e.g. 'ISO 4014 table' or 'proportion'",
        askable=True,  # numeric QA may target this parameter
    ),
    # TODO: add the rest. Mark optional-feature toggles with feature=True.
}


# ── 2. check ─────────────────────────────────────────────────────────────────
def check(p: dict) -> list[str]:
    """Inter-parameter engineering constraints. THE part humans review.

    Return the list of violated constraints (empty = valid). Every constraint
    carries its reason — cite the rule or standard.
    """
    bad = []
    # TODO — examples of the kind of constraint that belongs here:
    # if p["wall_t"] > p["height"] / 4:
    #     bad.append("wall_t > height/4: must stay plate-like (structural convention)")
    return bad


# ── 3. sample ────────────────────────────────────────────────────────────────
def sample(difficulty: str, rng) -> dict:
    """Draw a parameter set from PARAM_SPEC ranges that passes check().

    `rng` is a numpy Generator — use ONLY rng for randomness (same seed must
    reproduce the same parameters).
    """
    for _ in range(200):
        p = {}
        for name, spec in PARAM_SPEC.items():
            lo, hi = spec["range"][difficulty]
            p[name] = round(float(rng.uniform(lo, hi)), 2)
        # TODO: draw feature toggles / integer params explicitly, e.g.:
        # p["n_holes"] = int(rng.choice([0, 2])) if difficulty != "easy" else 0
        if not check(p):
            return p
    raise RuntimeError("could not sample valid parameters in 200 tries — widen ranges or relax check()")


# ── 4. build ─────────────────────────────────────────────────────────────────
def build(p):
    """Parameterized CadQuery — write PLAIN code, not a code generator.

    Read parameters as `p["name"]`, bind the finished solid to `result`, and
    return it. `bench2` derives each instance's stand-alone program from this
    body automatically (params become module globals, any geomlib helper you
    call is inlined) — so you never format numbers into strings or emit code.
    Import `cadquery as cq` / `math` / geomlib helpers at the top of the file.
    """
    length = p["length"]
    # TODO: build the part with ordinary CadQuery calls
    result = cq.Workplane("XY").box(length, length / 2.0, length / 4.0)
    return result
